"use client";

import { useEffect, useRef, useState } from "react";
import gsap from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";
import { PROJECTS } from "./VisualDiscovery";
import { Maximize2, ExternalLink } from "lucide-react";

interface ImmersiveGalleryProps {
  onOpenProject: (project: typeof PROJECTS[0]) => void;
  onOpenLightbox: (imageUrl: string) => void;
}

const GALLERY_ITEMS = [
  {
    id: "gal-1",
    title: "Mechanical Darkness",
    category: "Chrono Luxury",
    tag: "PRODUCTS",
    img: "/best shots/Product image/product-watch-dark.webp",
    aspect: "aspect-[4/5]",
    projectKey: "chrono-luxury",
  },
  {
    id: "gal-2",
    title: "Botanical Mist",
    category: "Product / Hairspray",
    tag: "PRODUCTS",
    img: "/best shots/Product image/product-hairspray.webp",
    aspect: "aspect-[3/4]",
    projectKey: "chrono-luxury",
  },
  {
    id: "gal-3",
    title: "Mutton Culinary Style",
    category: "Velvet Crème / Culinary",
    tag: "FOOD",
    img: "/best shots/Food photo/food-mutton.webp",
    aspect: "aspect-[4/3]",
    projectKey: "velvet-creme",
  },
  {
    id: "gal-4",
    title: "Refraction Macro",
    category: "Liquid Shadow / Beverage",
    tag: "BEVERAGES",
    img: "/best shots/Beverage images/bev-macro.webp",
    aspect: "aspect-[16/10]",
    projectKey: "liquid-shadow",
  },
  {
    id: "gal-5",
    title: "Molton Glow",
    category: "Product / Cosmetics",
    tag: "PRODUCTS",
    img: "/best shots/Product image/product-molton-brown.webp",
    aspect: "aspect-[3/4]",
    projectKey: "chrono-luxury",
  },
  {
    id: "gal-6",
    title: "Golden Curry Essence",
    category: "Velvet Crème / Culinary",
    tag: "FOOD",
    img: "/best shots/Food photo/food-curry.webp",
    aspect: "aspect-[4/3]",
    projectKey: "velvet-creme",
  },
  {
    id: "gal-7",
    title: "Heels of Prestige",
    category: "Solé Luxury / Fashion",
    tag: "FASHION",
    img: "/best shots/ladies shoe/shoe-ladies-heels.webp",
    aspect: "aspect-[3/4]",
    projectKey: "sole-luxury",
  },
  {
    id: "gal-8",
    title: "Studio Serum de Rosa",
    category: "Product / Serum",
    tag: "PRODUCTS",
    img: "/best shots/Product image/product-serum.webp",
    aspect: "aspect-[4/5]",
    projectKey: "chrono-luxury",
  },
  {
    id: "gal-9",
    title: "High-Fidelity Sonics",
    category: "Product / Headphone",
    tag: "PRODUCTS",
    img: "/best shots/Product image/product-headphone.webp",
    aspect: "aspect-[4/3]",
    projectKey: "chrono-luxury",
  },
];

const FILTERS = ["ALL", "PRODUCTS", "BEVERAGES", "FOOD", "FASHION"] as const;
type FilterType = (typeof FILTERS)[number];

export default function ImmersiveGallery({
  onOpenProject,
  onOpenLightbox,
}: ImmersiveGalleryProps) {
  const containerRef = useRef<HTMLDivElement>(null);
  const [activeFilter, setActiveFilter] = useState<FilterType>("ALL");

  const filteredItems = GALLERY_ITEMS.filter(
    (item) => activeFilter === "ALL" || item.tag === activeFilter
  );

  // Distribute items into 3 columns
  const columns: (typeof GALLERY_ITEMS)[] = [[], [], []];
  filteredItems.forEach((item, index) => {
    columns[index % 3].push(item);
  });

  useEffect(() => {
    gsap.registerPlugin(ScrollTrigger);

    const ctx = gsap.context(() => {
      // Clean soft vertical float-fade reveal per card
      gsap.utils.toArray<HTMLElement>(".gallery-item-card").forEach((card, i) => {
        gsap.fromTo(
          card,
          { opacity: 0, y: 40 },
          {
            opacity: 1,
            y: 0,
            duration: 1.0,
            ease: "power3.out",
            delay: (i % 3) * 0.08,
            scrollTrigger: {
              trigger: card,
              start: "top 88%",
              once: true,
            },
          }
        );

        // Subtle parallax on image
        const img = card.querySelector("img");
        if (img) {
          gsap.fromTo(
            img,
            { yPercent: -6 },
            {
              yPercent: 6,
              ease: "none",
              scrollTrigger: {
                trigger: card,
                start: "top bottom",
                end: "bottom top",
                scrub: true,
              },
            }
          );
        }
      });
    }, containerRef);

    return () => ctx.revert();
  }, [activeFilter]);

  return (
    <section
      ref={containerRef}
      id="gallery"
      className="relative w-full bg-[#F4EFE7] py-24 md:py-36 overflow-hidden"
    >
      {/* Section Header */}
      <div className="px-8 md:px-16 mb-16 md:mb-20">
        <div className="flex flex-col md:flex-row md:items-end justify-between gap-8 border-b border-[#111111]/10 pb-10">
          <div>
            <span className="font-mono text-[9px] uppercase tracking-[0.35em] text-[#9D8B74] font-bold block mb-4">
              [ SECTION 04 // IMMERSIVE ARCHIVE ]
            </span>
            <h2 className="font-serif text-5xl sm:text-6xl md:text-7xl tracking-tight text-[#111111] leading-none">
              Visual<br />
              <span className="italic font-normal text-[#9D8B74]">Catalog</span>
            </h2>
          </div>

          {/* Borderless text-link filter bar */}
          <nav
            aria-label="Gallery filter"
            className="flex flex-wrap gap-6 md:gap-8 items-end pb-1"
          >
            {FILTERS.map((filter) => (
              <button
                key={filter}
                onClick={() => setActiveFilter(filter)}
                className={`font-sans text-[11px] uppercase tracking-[0.25em] transition-all duration-300 pb-1 ${
                  activeFilter === filter
                    ? "text-[#111111] border-b border-[#111111]"
                    : "text-[#9D8B74] hover:text-[#111111]"
                }`}
              >
                {filter}
              </button>
            ))}
          </nav>
        </div>
      </div>

      {/* 3-Column Masonry */}
      <div className="px-8 md:px-16 grid grid-cols-1 md:grid-cols-3 gap-x-8 gap-y-0 items-start">
        {columns.map((column, colIdx) => (
          <div
            key={colIdx}
            className={`flex flex-col ${
              colIdx === 1
                ? "md:mt-16"
                : colIdx === 2
                ? "md:-mt-8"
                : ""
            }`}
          >
            {column.map((item, itemIdx) => {
              const project =
                PROJECTS.find((p) => p.id === item.projectKey) || PROJECTS[0];

              return (
                <div
                  key={item.id}
                  data-id={item.id}
                  className="gallery-item-card w-full group mb-12 md:mb-16"
                >
                  {/* Image frame — natural aspect ratio, no forced portrait */}
                  <div
                    onClick={() => onOpenLightbox(item.img)}
                    className={`relative w-full ${item.aspect} overflow-hidden cursor-pointer bg-[#E0D9CF] rounded-sm`}
                    data-cursor="view"
                  >
                    <img
                      src={item.img}
                      alt={item.title}
                      className="w-full h-full object-cover group-hover:scale-[1.04] transition-transform duration-700 ease-out"
                    />

                    {/* Hover Overlay */}
                    <div className="absolute inset-0 bg-[#111111]/0 group-hover:bg-[#111111]/20 transition-colors duration-500 z-10" />

                    {/* Expand icon */}
                    <div className="absolute top-4 right-4 bg-white/80 backdrop-blur-sm text-[#111111] p-2 rounded-full z-20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 shadow-sm">
                      <Maximize2 className="w-3 h-3" />
                    </div>
                  </div>

                  {/* Caption — clean, minimal */}
                  <div className="pt-5 flex justify-between items-start">
                    <div>
                      <h4 className="font-serif text-base md:text-lg text-[#111111] leading-tight">
                        {item.title}
                      </h4>
                      <span className="text-[9px] text-[#9D8B74] uppercase tracking-widest block mt-1 font-mono">
                        {item.category}
                      </span>
                    </div>

                    <button
                      onClick={() => onOpenProject(project)}
                      className="text-[9px] font-sans font-bold text-[#9D8B74] uppercase tracking-widest flex items-center gap-1 hover:text-[#111111] transition-colors duration-300 mt-1 shrink-0"
                      title="View Campaign Brief"
                    >
                      <span>Brief</span>
                      <ExternalLink className="w-2.5 h-2.5" />
                    </button>
                  </div>
                </div>
              );
            })}
          </div>
        ))}
      </div>
    </section>
  );
}
