# dependencies
/node_modules
/.pnp
/.yarn/*
!/.yarn/patches
!/.yarn/plugins
!/.yarn/releases
!/.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for commiting if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AI agent / dev tool config (NOT part of your website)
.claude
.impeccable
.opencode
.playwright-mcp
.qoder
.superpowers
.agents
agent-skills
 .fallow
 .kilo

# Logs & temp files
dev-err.log
dev-out.log
dev-3001-err.log
dev-3001.log
temp_analysis/
trae-page.txt
providers-list.txt
providers.txt

# Videos — committed ones stay; huge/unused ones are ignored.
# hero-video.mp4 was 222MB/4K -> compressed to 4.4MB/1080p for the deployed
# site, so it is now committed. The unused 222MB copy and best-shots clips stay out.
public/main-hero-shots/hero-video.mp4
public/best shots/*.mp4

# Reference materials (not source code)
ai-website-cloner-template/
reference/
docs/
.superdesign

# Stray nested repo accidentally tracked as a gitlink (breaks Netlify checkout)
/website

# Stale pnpm lock (project uses npm; a pnpm lock makes Netlify pick pnpm and fail)
pnpm-lock.yaml

# Project-specific analysis & exported assets
ANALYSIS.md
/services-section.png
# bun archive
bun-canary.zip
.vercel
